---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"About L, a developer writing about European railways, trains, public transport, photography, and travel.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I'm L, a developer who enjoys building things around railways and public transport.
		</p>
		<p>
			This blog is where I keep notes on europe railways, trains, public transport, photography, and
			travel.
		</p>
		<p>
			You can also visit <a
				class="cactus-link inline-block"
				href="https://bellotreno.org"
				rel="noreferrer"
				target="_blank">BelloTreno</a
			> for my railway project.
		</p>
	</div>
</PageLayout>
